import re
import subprocess
import time
import pandas as pd

NUM_PARES = 5
EXECUCOES_POR_PAR = 5
PROTOCOLO = "1"  # 0: Naive, 1: Server-Aided (3 partes), 2: DH-PSI (2 partes), 3: OT-PSI (2 partes)
PATH_DEMO = "../../demo.exe"

resultados = []

for i in range(NUM_PARES):
    arq_a = f"Dataset_{i}_A.csv"
    arq_b = f"Dataset_{i}_B.csv"

    print(f"--- Processando Par {i} com Protocolo -p {PROTOCOLO} ({arq_a} vs {arq_b}) ---")
    tempos_par = []
    elementos_comuns = 0

    for run in range(EXECUCOES_POR_PAR):
        inicio = time.perf_counter()

        if PROTOCOLO == "1":
            # Usa arq_a como ficheiro dummy do servidor porque já existe na pasta atual
            cmd_srv = [PATH_DEMO, "-r", "0", "-p", "1", "-f", arq_a, ]
            cmd_cli_a = [PATH_DEMO, "-r", "1", "-p", "1", "-f", arq_a]
            cmd_cli_b = [PATH_DEMO, "-r", "1", "-p", "1", "-f", arq_b]

            p_srv = subprocess.Popen(cmd_srv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            time.sleep(0.2)

            # Garante que o servidor não fechou imediatamente por erro
            if p_srv.poll() is not None:
                out_s, err_s = p_srv.communicate()
                raise RuntimeError(f"Servidor fechou prematuramente:\nSTDOUT: {out_s}\nSTDERR: {err_s}")

            p_cli_a = subprocess.Popen(cmd_cli_a, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            time.sleep(0.1)
            p_cli_b = subprocess.Popen(cmd_cli_b, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)

            try:
                out_cli_a, err_cli_a = p_cli_a.communicate(timeout=60)
                out_cli_b, err_cli_b = p_cli_b.communicate(timeout=60)
            except subprocess.TimeoutExpired:
                p_cli_a.kill()
                p_cli_b.kill()
                p_srv.kill()
                raise RuntimeError("Timeout: os clientes ficaram bloqueados à espera do servidor.")

            # Encerra o servidor caso ele não feche sozinho após responder aos clientes
            try:
                p_srv.communicate(timeout=3)
            except subprocess.TimeoutExpired:
                p_srv.terminate()

            out_total = (out_cli_a or "") + "\n" + (out_cli_b or "")

        else:
            cmd_srv = [PATH_DEMO, "-r", "0", "-p", PROTOCOLO, "-f", arq_a]
            cmd_cli = [PATH_DEMO, "-r", "1", "-p", PROTOCOLO, "-f", arq_b]

            p_srv = subprocess.Popen(cmd_srv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            time.sleep(0.2)
            p_cli = subprocess.Popen(cmd_cli, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)

            out_cli, err_cli = p_cli.communicate(timeout=60)
            p_srv.communicate(timeout=5)

            out_total = out_cli or ""

        fim = time.perf_counter()
        duracao = fim - inicio
        tempos_par.append(duracao)

        if run == 0 and out_total:
            match = re.search(r"Found\s+(\d+)\s+intersecting elements", out_total)
            if match:
                elementos_comuns = int(match.group(1))

        print(f"  Execução {run + 1}/{EXECUCOES_POR_PAR}: {duracao:.4f} s")

    tempo_medio = sum(tempos_par) / len(tempos_par)
    print(f"-> Tempo médio do Par {i}: {tempo_medio:.4f} s | Elementos em comum: {elementos_comuns}\n")

    resultados.append({
        "Par": i,
        "Protocolo": PROTOCOLO,
        "Ficheiro A": arq_a,
        "Ficheiro B": arq_b,
        "Tempo Médio (s)": round(tempo_medio, 4),
        "Elementos Comuns": elementos_comuns
    })

df_res = pd.DataFrame(resultados)
print("=== RESULTADOS FINAIS ===")
print(df_res.to_string(index=False))

df_res.to_csv("resultados_execucao.csv", index=False)
